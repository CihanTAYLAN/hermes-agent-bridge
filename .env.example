# Runtime
NODE_ENV=production
PORT=3000
DATABASE_URL=

# Dokploy staging compose interpolation
BRIDGE_IMAGE_DIGEST=ghcr.io/example/hermes-agent-bridge@sha256:replace-with-immutable-digest
BRIDGE_STAGING_HOST=hermes-bridge-staging.example.com

# Inbound HMAC keyrings
BRIDGE_AGENT_ALPHA_ACTIVE_SECRET=
BRIDGE_AGENT_ALPHA_PREVIOUS_SECRET=
BRIDGE_AGENT_BETA_ACTIVE_SECRET=
BRIDGE_AGENT_BETA_PREVIOUS_SECRET=

# Outbound Hermes webhooks
BRIDGE_TO_ALPHA_WEBHOOK_URL=https://alpha-webhook.example.invalid/webhooks/peer-beta
BRIDGE_TO_ALPHA_WEBHOOK_ACTIVE_SECRET=
BRIDGE_TO_BETA_WEBHOOK_URL=https://beta-webhook.example.invalid/webhooks/peer-alpha
BRIDGE_TO_BETA_WEBHOOK_ACTIVE_SECRET=

# Payload encryption: the version selects BRIDGE_PAYLOAD_KEY_<VERSION>_BASE64.
# Keys must decode to exactly 32 bytes. Previous keys are decrypt-only.
BRIDGE_PAYLOAD_KEY_VERSION=v1
BRIDGE_PAYLOAD_KEY_V2_BASE64=
BRIDGE_PAYLOAD_KEY_V1_BASE64=
BRIDGE_PAYLOAD_KEY_V0_BASE64=
BRIDGE_PAYLOAD_PREVIOUS_KEY_VERSION=

# Deterministic routing / safety
# Telegram chat/thread allowlists belong to each Hermes plugin profile, not the Bridge API.
BRIDGE_REQUESTS_ENABLED=false
BRIDGE_REPLAY_WINDOW_SECONDS=300
BRIDGE_MAX_BODY_BYTES=65536
BRIDGE_RATE_LIMIT_PER_SECOND=30

# Delivery worker
BRIDGE_WORKER_POLL_INTERVAL_MS=250
BRIDGE_DELIVERY_TIMEOUT_MS=10000
BRIDGE_WORKER_BATCH_SIZE=10
BRIDGE_WORKER_LEASE_SECONDS=30
BRIDGE_WORKER_MAX_ATTEMPTS=4
BRIDGE_WORKER_BASE_DELAY_MS=1000
BRIDGE_WORKER_MAX_DELAY_MS=60000

# Observability
BRIDGE_METRICS_TOKEN=
